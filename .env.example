# Copy to .env and adjust. .env is gitignored — never commit real secrets.
#
#   cp .env.example .env
#
# The compose files set what the containers need, so .env is mostly for running
# outside Docker and for local overrides. Every setting has a working default;
# see backend/src/attendance/config/settings.py for the full list.

# ── core ─────────────────────────────────────────────────────────────────────
ATTENDANCE_ENVIRONMENT=local          # local | dev | staging | prod
ATTENDANCE_LOG_LEVEL=INFO
ATTENDANCE_LOG_JSON=false             # true in deployed environments (one JSON object per line)

# ── database ─────────────────────────────────────────────────────────────────
# PostgreSQL is the runtime database. Start it with make db-up.
ATTENDANCE_DATABASE_URL=postgresql+asyncpg://attendance:attendance@localhost:55433/attendance
# Tests explicitly select SQLite.
ATTENDANCE_DB_ECHO=false

# ── host ports ───────────────────────────────────────────────────────────────
# Change these when you run more than one of these apps at once — the defaults
# collide. Only the *host* side moves; nothing inside the stack is affected.
ATTENDANCE_WEB_HOST_PORT=5184         # Vite dev server
ATTENDANCE_API_HOST_PORT=8001         # FastAPI (dev), and the whole app in prod
ATTENDANCE_APP_HOST_PORT=8001         # docker-compose.prod.yml
ATTENDANCE_DEBUG_HOST_PORT=5679       # debugpy
ATTENDANCE_DB_HOST_PORT=55433         # Postgres — already non-default to avoid a local one
ATTENDANCE_LOCALSTACK_HOST_PORT=4566

# ── object storage ───────────────────────────────────────────────────────────
# Empty bucket = in-memory storage (uploads vanish on restart — fine locally,
# a bug in production). `make up-aws` sets these to LocalStack automatically.
ATTENDANCE_S3_BUCKET=
ATTENDANCE_S3_ENDPOINT_URL=           # only for LocalStack/MinIO; empty for real AWS S3
ATTENDANCE_S3_ACCESS_KEY=             # empty in AWS: the instance role is used instead
ATTENDANCE_S3_SECRET_KEY=
ATTENDANCE_S3_REGION=us-east-1

# ── sign-in ──────────────────────────────────────────────────────────────────
# Google is on when the client id is set. In Google Cloud console, create an
# OAuth client (Web application) and add this redirect URI:
#   <ATTENDANCE_PUBLIC_URL>/api/v1/auth/google/callback
ATTENDANCE_GOOGLE_CLIENT_ID=
ATTENDANCE_GOOGLE_CLIENT_SECRET=
ATTENDANCE_AUTH_DEV_LOGIN=true        # "sign in as the dev user" button; refused in staging/prod
ATTENDANCE_ALLOWED_EMAIL_DOMAINS=[]   # e.g. ["schoolnetindia.com"]
ATTENDANCE_ALLOWED_STAFF_EMAILS=[]          # Exact authorized staff addresses. Configure at least one allowlist for Google.
ATTENDANCE_PUBLIC_URL=http://localhost:5184   # the browser's origin; in prod your real URL
ATTENDANCE_SESSION_SECRET=dev-session-secret  # prod: a long random string
ATTENDANCE_COOKIE_SECURE=false        # true behind HTTPS

# ── production only ──────────────────────────────────────────────────────────
# Where the built SPA lives. Set in the production image; leave empty in dev,
# where Vite serves the frontend instead.
# ATTENDANCE_FRONTEND_DIR=/app/frontend

# Postgres password for docker-compose.prod.yml.
# POSTGRES_PASSWORD=

# Frontend: live uses the API; mock explicitly selects fictional in-browser data.
VITE_ATTENDANCE_DATA_MODE=live
VITE_API_PROXY=http://localhost:8001
